# ─────────────────────────────────────────────────────────────────────────────
# Paradise Homes RD — Variables de entorno (ejemplo)
# Copia este archivo a `apps/web/.env.local` y completa los valores.
# NUNCA subas `.env` ni `.env.local` a Git.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Paradise Homes RD"

# Contacto administrativo (fase 1)
NEXT_PUBLIC_ADMIN_WHATSAPP=18498620269
NEXT_PUBLIC_ADMIN_CONTACT_NAME="Joshua Steven Williams Ortiz"

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo backend / server. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Para migraciones y `db:seed` (connection string de Postgres)
SUPABASE_DB_URL=
# Project ref para `supabase gen types`
SUPABASE_PROJECT_ID=

# ── Mapas (Google Maps) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Almacenamiento multimedia ───────────────────────────────────────────────
# Fase 1: Supabase Storage (bucket configurado en migraciones).
# Alternativa: Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL="Paradise Homes RD <no-reply@paradisehomesrd.com>"

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Error monitoring (Sentry) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_PARADISE_AI=false
NEXT_PUBLIC_ENABLE_MORTGAGE_CALCULATOR=true
NEXT_PUBLIC_ENABLE_COMPARE=true
