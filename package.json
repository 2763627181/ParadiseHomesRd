{
  "name": "paradise-homes-rd",
  "private": true,
  "version": "0.1.0",
  "description": "Paradise Homes RD — marketplace inmobiliario premium para República Dominicana.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean",
    "db:migrate": "pnpm --filter @paradise/database migrate",
    "db:seed": "pnpm --filter @paradise/database seed",
    "db:reset": "pnpm --filter @paradise/database reset",
    "db:types": "pnpm --filter @paradise/database types",
    "web": "pnpm --filter @paradise/web"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
